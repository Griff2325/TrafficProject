# Keep .gitignore itself
# .gitignore

# Virtual Environment
.env
.venv/
env/
venv/
ENV/

# --- Data --- 
# Ignore data content by default, but keep specific processed file
data/raw/*
!data/raw/.gitkeep
# Ignore processed except the main feature file
data/processed/*
# !data/processed/accidents_with_features.csv
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/temporary/*

# Ignore geospatial data content
data/geospatial/*
# Use .gitkeep in data/geospatial/ if you want to track the empty dir

# --- Generated Reports/Figures --- 
# Ignore figures content by default
reports/figures/*
!reports/figures/.gitkeep

# --- Documentation --- 
# Allow tracking docs directory, but ignore specific files
# docs/ <-- REMOVED this line
docs/project_plan.md
docs/project_summary.md
docs/poster_guidelines.md
# docs/eda_results.md <-- REMOVE THIS LINE TO ALLOW TRACKING
docs/project_completion.md

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Reports and Models (Keep .gitkeep if present)
reports/models/*
!reports/models/.gitkeep

# Model artifacts (Keep .gitkeep in models/ dir if present)
# Ignore model files by default
*.pkl
*.joblib
*.model
*.pth
*.h5
*.hdf5
models/*
*.json 
# Keep specific model and config files
# !models/xgb_model.json
!models/config.json # Example: Keep a specific config file if needed
!models/.gitkeep

# Logs and caches
logs/
*.log
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~
.cursorrules

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Temporary files
tmp/
temp/

# --- KEEP THESE --- 
# Keep essential project files (override general rules if necessary)
!README.md
!requirements.txt
