# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.env
.venv/
env/
venv/
ENV/

# --- Data --- 
# Ignore all content within data subdirectories, except .gitkeep files
# This prevents committing large datasets.
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# --- Generated Reports/Figures --- 
# Ignore all content within the figures directory, except .gitkeep
reports/figures/*
!reports/figures/.gitkeep

# --- Documentation --- 
# Ignore the entire docs directory and its contents
docs/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Reports and Models (Keep .gitkeep if present)
reports/models/*
!reports/models/.gitkeep

# Model artifacts (Keep .gitkeep in models/ dir if present)
*.pkl
*.joblib
*.model
*.json # Also ignore model json files, except maybe config
!models/config.json # Example: Keep a specific config file if needed
*.h5
*.hdf5
models/*
!models/.gitkeep

# Logs and caches
logs/
*.log
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Temporary files
tmp/
temp/

# --- KEEP THESE --- 
# Keep essential project files (override general rules if necessary)
!README.md
!requirements.txt
