{
    "rules": {
        "python": {
            "imports": {
                "data_processing": ["pandas", "numpy", "scipy"],
                "geospatial": ["geopy", "geopandas", "folium"],
                "visualization": ["matplotlib", "seaborn", "plotly"],
                "machine_learning": ["sklearn", "xgboost", "shap"],
                "time_series": ["statsmodels", "prophet"]
            },
            "style": {
                "max_line_length": 100,
                "docstring_style": "google",
                "import_order": ["standard_library", "third_party", "local"]
            }
        },
        "data_analysis": {
            "data_quality": {
                "null_threshold": 0.3,
                "duplicate_threshold": 0.1
            },
            "visualization": {
                "color_palette": "viridis",
                "figure_size": [12, 8],
                "font_size": 12
            }
        },
        "file_organization": {
            "data": {
                "raw": "data/raw",
                "processed": "data/processed",
                "interim": "data/interim"
            },
            "notebooks": "notebooks",
            "src": {
                "data": "src/data",
                "features": "src/features",
                "models": "src/models",
                "visualization": "src/visualization"
            }
        }
    }
} 